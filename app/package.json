{
	"name": "react-typescript-vite-boilerplate",
	"version": "1.0.0",
	"description": "A boilerplate that uses React, Typescript and Vite to build desktop applications.",
	"main": "./dist/main.js",
	"scripts": {
		"dev": "NODE_ENV=dev npm run react:dev",
		"react:dev": "vite",
		"react:build": "vite build",
		"react:start": "vite preview",
		"build": "npm run react:build && cp -r src/ dist/src/"
	},
	"author": "Cloudway",
	"license": "MIT",
	"devDependencies": {
		"@types/crypto-js": "^4.2.1",
		"@types/node": "^24.0.0",
		"@types/react": "^18.0.26",
		"@types/react-dom": "^18.0.9",
		"@types/styled-components": "^5.1.26",
		"@vitejs/plugin-react": "^6.1.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^7.18.4",
		"styled-components": "^5.3.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vite-plugin-svgr": "^5.2.0"
	},
	"dependencies": {
		"axios": "^1.20.0",
		"bcryptjs": "^3.0.3",
		"crypto-js": "^4.2.0",
		"dompurify": "^3.4.17",
		"openpgp": "^6.3.2",
		"react-toastify": "^9.1.3"
	},
	"engines": {
		"node": ">=24.22.1"
	}
}
